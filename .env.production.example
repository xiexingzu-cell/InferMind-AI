# ============================================================
# InferMind — 生产环境变量
# ============================================================
# 复制此文件为 .env.production 并填入真实值:
#   cp .env.production.example .env.production
#
# 启动:
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
# ============================================================

# === PostgreSQL ===
POSTGRES_DB=infermind
POSTGRES_USER=gateway
POSTGRES_PASSWORD=replace_with_strong_password

# === Backend Database URL (用上面的值；host 必须写 postgres) ===
DATABASE_URL=postgresql+asyncpg://gateway:replace_with_strong_password@postgres:5432/infermind

# === Redis ===
REDIS_URL=redis://redis:6379

# === Platform ===
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_to_64_char_hex_string
LOG_LEVEL=INFO

# === Internal API Key (供前端 Chat UI 使用) ===
# Generate: python -c "import secrets; print('gw-' + secrets.token_urlsafe(16))"
INTERNAL_API_KEY=gw-your_random_key_here

# === CORS ===
# 你的服务器域名或 IP（可逗号分隔多个），开发阶段可用 *
CORS_ORIGINS=*

# === Provider API Keys ===
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1

DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

GEMINI_API_KEY=AIza...

# === Rate Limiting ===
RATE_LIMIT_RPM=60

# === Frontend ===
# 同源部署（nginx 反向代理）→ 保持为空
# 如果前后端分离（不同域名）→ 填写后端完整地址（如 https://api.yourdomain.com）
NEXT_PUBLIC_API_URL=

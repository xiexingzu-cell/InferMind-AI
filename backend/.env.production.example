# === Environment ===
ENVIRONMENT=production
LOG_LEVEL=INFO

# === Database ===
# Railway PostgreSQL: copy from Railway dashboard → Variables tab
DATABASE_URL=postgresql+asyncpg://postgres:PASSWORD@HOST:5432/railway

# === Redis ===
# Railway Redis: copy from Railway dashboard → Variables tab
REDIS_URL=redis://default:PASSWORD@HOST:6379

# === Platform ===
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_64_char_hex_secret_here

# === CORS ===
# Your Vercel frontend URL (no trailing slash)
CORS_ORIGINS=https://your-project.vercel.app

# === Provider API Keys ===
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1

DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

GEMINI_API_KEY=AIza...

# === Rate Limiting ===
RATE_LIMIT_RPM=60

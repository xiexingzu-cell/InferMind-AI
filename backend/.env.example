# === Database ===
DATABASE_URL=postgresql+asyncpg://gateway:gateway_dev@localhost:5432/infermind

# === Redis ===
REDIS_URL=redis://localhost:6379

# === Platform ===
# Used to sign internal tokens — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_in_production

# === Provider API Keys ===
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1

DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

GEMINI_API_KEY=AIza...

# === Internal Key for Public Chat UI ===
# Set the same value as NEXT_PUBLIC_INTERNAL_API_KEY in frontend/.env.local
# Generate: python -c "import secrets; print('gw-' + secrets.token_urlsafe(16))"
INTERNAL_API_KEY=gw-dev-internal-key

# === Rate Limiting ===
# Requests per minute per API key (default: 60)
RATE_LIMIT_RPM=60
